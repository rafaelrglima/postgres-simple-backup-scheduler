# PostgreSQL Database Configuration
# Copy this file to .env and configure with your actual credentials
# IMPORTANT: Never commit .env file to version control!

# Database connection settings
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=your_secure_password_here

# Databases to exclude from backups (space-separated list)
# Common exclusions: postgres (system db), template0, template1 (template dbs)
EXCLUDE_DBS="postgres template0 template1"

# Notes:
# - DB_USER: PostgreSQL user with backup privileges (typically 'postgres')
# - DB_HOST: Database server hostname or IP (use 'localhost' for local)
# - DB_PORT: PostgreSQL port (default is 5432)
# - DB_PASSWORD: Database password for the specified user
# - EXCLUDE_DBS: Space-separated list of database names to skip during backup

